# Unity generated folders. These are rebuilt locally and must never be committed.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files for folders Unity itself ignores
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Python, for the analysis scripts
__pycache__/
*.pyc
.venv/
venv/

# Session data written at run time. Commit only the sample in Analysis/
summary.csv
events_*.csv
